{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "common",
  "sourceRoot": "ansible-galaxy/collections/ansible_collections/levonk/common",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/build-collection.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      },
      "outputs": ["dist/levonk-common-*.tar.gz"]
    },
    "test": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/test-collection.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "lint": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/lint-collection.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "publish-beta": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/publish10-beta.sh",
        "args": ["common", "${ANSIBLE_GALAXY_TOKEN}", "dist"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      },
      "dependsOn": ["build"]
    },
    "publish-prod": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/publish20-prod.sh",
        "args": ["common", "${ANSIBLE_GALAXY_TOKEN}", "dist"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      },
      "dependsOn": ["build"]
    },
    "promote-build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=build", "ansible-galaxy/collections/ansible_collections", "common"],
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "promote-minor": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=minor", "ansible-galaxy/collections/ansible_collections", "common"],
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "promote-major": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=major", "ansible-galaxy/collections/ansible_collections", "common"],
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-src": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from10-src.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-repo": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from20-repo.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from30-build.sh",
        "args": ["common"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      },
      "dependsOn": ["build"]
    },
    "inst-beta": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from40-beta.sh",
        "args": ["common", "${GALAXY_BETA_SERVER}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-prod": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from50-prod.sh",
        "args": ["common", "${GALAXY_PROD_SERVER}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "common",
          "NAMESPACE": "levonk"
        }
      }
    },
    "uninstall": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "command": "ansible-galaxy collection remove levonk.common || echo \"Collection levonk.common not installed or already removed\""
      }
    }
  },
  "tags": ["collection", "ansible-galaxy"]
}
