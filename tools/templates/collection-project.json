{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "{{collectionName}}",
  "sourceRoot": "ansible-galaxy/collections/ansible_collections/levonk/{{collectionName}}",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/build-collection.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      },
      "outputs": ["dist/levonk-{{collectionName}}-*.tar.gz"]
    },
    "test": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/test-collection.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "lint": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/lint-collection.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "publish-beta": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/publish10-beta.sh",
        "args": ["{{collectionName}}", "${ANSIBLE_GALAXY_TOKEN}", "dist"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "publish-prod": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/publish20-prod.sh",
        "args": ["{{collectionName}}", "${ANSIBLE_GALAXY_TOKEN}", "dist"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "promote-build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=build", "ansible-galaxy/collections/ansible_collections", "{{collectionName}}"],
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "promote-minor": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=minor", "ansible-galaxy/collections/ansible_collections", "{{collectionName}}"],
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "promote-major": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "bin/promote-versions.sh",
        "args": ["--type=major", "ansible-galaxy/collections/ansible_collections", "{{collectionName}}"],
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-src": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from10-src.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-repo": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from20-repo.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-build": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from30-build.sh",
        "args": ["{{collectionName}}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-beta": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from40-beta.sh",
        "args": ["{{collectionName}}", "${GALAXY_BETA_SERVER}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "inst-prod": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "script": "ansible-galaxy/bin/install-from50-prod.sh",
        "args": ["{{collectionName}}", "${GALAXY_PROD_SERVER}"],
        "cwd": "ansible-galaxy",
        "env": {
          "COLLECTION": "{{collectionName}}",
          "NAMESPACE": "levonk"
        }
      }
    },
    "uninstall": {
      "executor": "./tools/executors/shell:run",
      "options": {
        "command": "ansible-galaxy collection remove levonk.{{collectionName}} || echo \"Collection levonk.{{collectionName}} not installed or already removed\""
      }
    }
  },
  "tags": ["collection", "ansible-galaxy"]
}
