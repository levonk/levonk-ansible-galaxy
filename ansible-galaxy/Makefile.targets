# ====================================================================
# Makefile.targets - Shared Targets for Ansible Galaxy Collections
# This file provides additional targets that are included by the main Makefile.
# It is not meant to be executed directly.
# ====================================================================

# Prevent multiple inclusions
ifndef MAKEFILE_TARGETS_INCLUDED
MAKEFILE_TARGETS_INCLUDED := true

# ====================================================================
# Configuration
# ====================================================================

# Tool detection
CONTAINER_RUNTIME ?= $(shell command -v podman 2>/dev/null || command -v docker 2>/dev/null || echo '')
HAS_ANSIBLE_BUILDER ?= $(shell command -v ansible-builder 2>/dev/null)
HAS_ANSIBLE_LINT ?= $(shell command -v ansible-lint 2>/dev/null)
HAS_MOLECULE ?= $(shell command -v molecule 2>/dev/null)
HAS_YAMLLINT ?= $(shell command -v yamllint 2>/dev/null)

# Execution Environment
EE_FULL_IMAGE ?= $(PROJECT_NAME):latest

# Directories and Markers
MARKER_DIR ?= .markers
BETA_MARKER ?= $(MARKER_DIR)/beta.marker
DIST_DIR ?= $(ROOT_DIR)/dist


# ====================================================================
# Local Build Target (No Token Required)
# ====================================================================

# Local build target (skips token check)
local-build: ## Build all collections locally without token check
	@echo "\n\033[1mBuilding Collections Locally\033[0m"
	@echo "=========================="
	@if [ -z "$(COLLECTIONS)" ]; then \
		echo "\033[1;33mNo collections found in $(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/\033[0m"; \
		exit 0; \
	fi
	@FAILED=0; \
	for collection in $(COLLECTIONS); do \
		COLLECTION_DIR="$(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/$$collection"; \
		if [ -d "$$COLLECTION_DIR" ]; then \
			echo "\n\033[1m• Building: $(NAMESPACE).$$collection\033[0m"; \
			if ! (cd "$$COLLECTION_DIR" && $(MAKE) local-build || $(MAKE) build); then \
				echo "\033[1;31m✗ Build failed: $(NAMESPACE).$$collection\033[0m"; \
				FAILED=$$((FAILED + 1)); \
			else \
				echo "\033[1;32m✓ Built: $(NAMESPACE).$$collection\033[0m"; \
			fi \
		else \
			echo "\033[1;33m• Skipping: $(NAMESPACE).$$collection (directory not found)\033[0m"; \
		fi \
	done; \
	if [ "$$FAILED" -gt 0 ]; then \
		echo "\n\033[1;31m✗ Build completed with $$FAILED failure(s)\033[0m"; \
		exit 1; \
	else \
		echo "\n\033[1;32m✓ All collections built successfully!\033[0m"; \
	fi

# ====================================================================
# Project Archive and Version Management
# ====================================================================

# Create a project archive
archive: ## Create project archive
	@echo "[ARCHIVE] Creating project archive..."
	@mkdir -p $(DIST_DIR)
	git archive --format=tar.gz --prefix=$(PROJECT_NAME)-$(VERSION)/ HEAD > $(DIST_DIR)/$(PROJECT_NAME)-$(VERSION).tar.gz

# ====================================================================
# Formatting and Code Quality
# ====================================================================

# Format Python code (part of the shared formatting targets)
format-python: ## Format Python code using black
	@echo "[FORMAT] Formatting Python code..."
	@if command -v black >/dev/null 2>&1; then \
		find . -name '*.py' -exec black {} +; \
	else \
		echo "black not installed. Install with: pip install black"; \
	fi
	@if command -v prettier >/dev/null 2>&1; then \
		find . -name '*.{json,md,yml,yaml}' -exec prettier --write {} +; \
	else \
		echo "prettier not installed. Install with: npm install -g prettier"; \
	fi

# (Generic uninstall target removed - using the more specific Ansible Galaxy collections uninstall target below)

# ====================================================================
# Execution Environment Targets
# ====================================================================

# Build the execution environment image
ee-build: check-container-runtime check-ansible-builder
	@echo "[EE] Building execution environment..."
	ansible-builder build -t $(EE_FULL_IMAGE) -f execution-environment.yml

# Run tests in execution environment
ee-test: ee-build
	@echo "[EE] Running tests in execution environment..."
	$(CONTAINER_RUNTIME) run --rm -v $(PWD):/runner $(EE_FULL_IMAGE) \
		ansible-test sanity --docker

# Run linters in execution environment
ee-lint: ee-build
	@echo "[EE] Running linters in execution environment..."
	$(CONTAINER_RUNTIME) run --rm -v $(PWD):/runner $(EE_FULL_IMAGE) \
		ansible-lint .

# Get a shell in the execution environment
ee-shell: ee-build
	@echo "[EE] Starting shell in execution environment..."
	$(CONTAINER_RUNTIME) run -it --rm -v $(PWD):/runner $(EE_FULL_IMAGE) /bin/bash

# Clean execution environment images
ee-clean:
	@echo "[EE] Cleaning up execution environment..."
	-$(CONTAINER_RUNTIME) rmi $(EE_FULL_IMAGE) 2>/dev/null || true

# Check if container runtime is available
check-container-runtime:
	@if [ -z "$(CONTAINER_RUNTIME)" ]; then \
		echo "ERROR: Neither podman nor docker is installed. Please install one of them."; \
		exit 1; \
	fi

# Check if ansible-builder is available
check-ansible-builder:
	@if [ -z "$(HAS_ANSIBLE_BUILDER)" ]; then \
		echo "ERROR: ansible-builder is not installed. Please install it with 'pip install ansible-builder'"; \
		exit 1; \
	fi

# ====================================================================
# Installation Targets (moved from main Makefile)
# ====================================================================

# ====================================================================
# Installation Targets
# ====================================================================

# ====================================================================
# Debug Target
# ====================================================================

debug:
	@echo "=== Debug Information ==="
	@echo "Project: $(PROJECT_NAME)"
	@echo "Version: $(VERSION)"
	@echo "Root Directory: $(ROOT_DIR)"
	@echo "Bin Directory: $(BIN_DIR)"
	@echo "Container Runtime: $(CONTAINER_RUNTIME)"
	@echo "Execution Environment: $(EE_FULL_IMAGE)"
	@echo "\n=== Tools ==="
	@echo "Ansible Lint: $(if $(HAS_ANSIBLE_LINT),Installed,Not Found)"
	@echo "Molecule: $(if $(HAS_MOLECULE),Installed,Not Found)"
	@echo "YAML Lint: $(if $(HAS_YAMLLINT),Installed,Not Found)"
	@echo "Ansible Builder: $(if $(HAS_ANSIBLE_BUILDER),Installed,Not Found)"
	@echo "\n=== Collections ==="
	@ls -la collections/ansible_collections/levonk/ 2>/dev/null || echo "No collections found in collections/ansible_collections/levonk/"
	@echo "\n=== Distribution ==="
	@ls -la dist/ 2>/dev/null || echo "No distribution files found in dist/"

# ====================================================================
# Development Environment Targets
# ====================================================================

# Watch for file changes and rebuild
watch: ## Watch for file changes and rebuild
	@echo "[WATCH] Watching for file changes..."
	@if ! command -v inotifywait >/dev/null 2>&1; then \
		echo "inotify-tools not installed. Install with: sudo apt-get install inotify-tools"; \
		exit 1; \
	fi
	@echo "[WATCH] Watching for changes in $(COLLECTIONS_DIR)/*"
	@while true; do \
		inotifywait -r -e modify,create,delete $(COLLECTIONS_DIR) && \
		echo "[WATCH] Detected changes, running tests..." && \
		make test; \
	done

# Development environment setup
env: ## Show development environment information
	@echo "\n\033[1mDevelopment Environment Information\033[0m"
	@echo "========================================"
	@echo "\n\033[1mProject Configuration:\033[0m"
	@echo "  Project Name: $(PROJECT_NAME)"
	@echo "  Version: $(VERSION)"
	@echo "  Root Directory: $(ROOT_DIR)"
	@echo "  Bin Directory: $(BIN_DIR)"
	@echo "  Dist Directory: $(DIST_DIR)"
	@echo "  Collections Directory: $(COLLECTIONS_DIR)"
	@echo "  Marker Directory: $(MARKER_DIR)"
	@echo "  Beta Marker: $(BETA_MARKER)"
	@echo "  Container Runtime: $(CONTAINER_RUNTIME)"
	@echo "  EE Image: $(EE_FULL_IMAGE)"
	@echo "\n\033[1mAvailable Tools:\033[0m"
	@echo "  Ansible Builder: $(if $(HAS_ANSIBLE_BUILDER),$(HAS_ANSIBLE_BUILDER),Not Found)"
	@echo "  Ansible Lint: $(if $(HAS_ANSIBLE_LINT),$(HAS_ANSIBLE_LINT),Not Found)"
	@echo "  Molecule: $(if $(HAS_MOLECULE),$(HAS_MOLECULE),Not Found)"
	@echo "  YAML Lint: $(if $(HAS_YAMLLINT),$(HAS_YAMLLINT),Not Found)"
	@echo "\n\033[1mAvailable Collections:\033[0m"
	@if [ -d "$(COLLECTIONS_DIR)/ansible_collections/levonk" ]; then \
		ls -1 "$(COLLECTIONS_DIR)/ansible_collections/levonk" | while read col; do \
			if [ -f "$(COLLECTIONS_DIR)/ansible_collections/levonk/$$col/galaxy.yml" ]; then \
				version=$$(grep '^version:' "$(COLLECTIONS_DIR)/ansible_collections/levonk/$$col/galaxy.yml" | awk '{print $$2}'); \
				echo "  - $$col (v$$version)"; \
			else \
				echo "  - $$col (no version info)"; \
			fi; \
		done; \
	else \
		echo "  No collections found"; \
	fi
	@echo "\n\033[1mEnvironment Variables:\033[0m"
	@echo "  ANSIBLE_CONFIG=$${ANSIBLE_CONFIG:-Not Set}"
	@echo "  ANSIBLE_COLLECTIONS_PATH=$${ANSIBLE_COLLECTIONS_PATH:-Not Set}"
	@echo "  ANSIBLE_GALAXY_TOKEN=$${ANSIBLE_GALAXY_TOKEN:+[REDACTED]}"
	@echo "\nRun 'make help' for available targets."

# Sync with remote repository
sync: ## Sync with remote repository (git pull --rebase)
	@echo "[SYNC] Syncing with remote repository..."
	git pull --rebase
	git submodule update --init --recursive

# Create a new module in a collection
new-module: ## Create a new module in a collection
	@if [ -z "$(collection)" ]; then \
		echo "Error: Collection not specified. Usage: make new-module collection=collection_name module=module_name [type=module_type]"; \
		exit 1; \
	fi
	@if [ -z "$(module)" ]; then \
		echo "Error: Module name not specified. Usage: make new-module collection=collection_name module=module_name [type=module_type]"; \
		exit 1; \
	fi
	@if [ ! -f "$(BIN_DIR)/setup-new30-module.sh" ]; then \
		echo "Error: setup-new30-module.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/setup-new30-module.sh "$(collection)" "$(module)" "$(type)"

# Create a new collection
new-collection: ## Create a new collection
	@if [ -z "$(collection)" ]; then \
		echo "Error: Collection name not specified. Usage: make new-collection collection=collection_name"; \
		exit 1; \
	fi
	@if [ ! -f "$(BIN_DIR)/setup-new20-collection.sh" ]; then \
		echo "Error: setup-new20-collection.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/setup-new20-collection.sh "$(collection)"

# Create a new role in a collection
new-role: ## Create a new role in a collection
	@if [ -z "$(collection)" ]; then \
		echo "Error: Collection not specified. Usage: make new-role collection=collection_name role=role_name"; \
		exit 1; \
	fi
	@if [ -z "$(role)" ]; then \
		echo "Error: Role name not specified. Usage: make new-role collection=collection_name role=role_name"; \
		exit 1; \
	fi
	@if [ ! -f "$(BIN_DIR)/setup-new10-role.sh" ]; then \
		echo "Error: setup-new10-role.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/setup-new10-role.sh "$(collection)" "$(role)"

# ====================================================================
# Collection Installation Targets
# ====================================================================

# Collection build target (builds a single collection when COLLECTION is set)
build: $(addprefix build-,$(COLLECTIONS))

build-%:
	@if [ ! -f "$(BIN_DIR)/build10-collection.sh" ]; then \
		echo "Error: build10-collection.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@"$(BIN_DIR)/build10-collection.sh" "$*" "$(COLLECTIONS_DIR)" "$(DIST_DIR)" "$(NAMESPACE)"

# Collection test target
test: $(addprefix test-,$(COLLECTIONS))

test-%: build-%
	@echo "Testing collection $(NAMESPACE).$*..."
	cd $(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/$* && ansible-test sanity

# Collection lint target
lint: $(addprefix lint-,$(COLLECTIONS))

lint-%:
	@echo "Linting collection $(NAMESPACE).$*..."
	@if [ ! -d "$(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/$*" ]; then \
		echo "Error: Collection directory not found: $(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/$*"; \
		exit 1; \
	fi
	cd $(COLLECTIONS_DIR)/ansible_collections/$(NAMESPACE)/$* && ansible-lint .

# Install from built artifacts (handles both single collection and multiple collections)
inst-build: build ## Install collections from built artifacts
	@echo "Installing collections from built artifacts..."
	@if [ -n "$(COLLECTION)" ]; then \
		if [ ! -f "$(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz" ]; then \
			echo "Error: Built collection not found: $(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz"; \
			exit 1; \
		fi; \
		ansible-galaxy collection install -f "$(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz"; \
	else \
		if [ ! -f "$(BIN_DIR)/install-from30-build.sh" ]; then \
			echo "Error: install-from30-build.sh script not found in $(BIN_DIR)"; \
			exit 1; \
		fi; \
		$(BIN_DIR)/install-from30-build.sh "$(COLLECTIONS)" "$(DIST_DIR)"; \
	fi

# Install from beta server (handles both single collection and multiple collections)
inst-beta: ## Install collections from beta server
	@echo "Installing collections from beta server..."
	@if [ -z "$(GALAXY_BETA_SERVER)" ]; then \
		echo "Error: GALAXY_BETA_SERVER is not set"; \
		exit 1; \
	fi
	@if [ -n "$(COLLECTION)" ]; then \
		ansible-galaxy collection install -f -p ~/.ansible/collections \
			--server $(GALAXY_BETA_SERVER) \
			$(NAMESPACE).$(COLLECTION); \
	else \
		if [ ! -f "$(BIN_DIR)/install-from40-beta.sh" ]; then \
			echo "Error: install-from40-beta.sh script not found in $(BIN_DIR)"; \
			exit 1; \
		fi; \
		$(BIN_DIR)/install-from40-beta.sh "$(COLLECTIONS)"; \
	fi

# ====================================================================
# Publishing Targets
# ====================================================================


# Publish to production server (handles both single collection and multiple collections)
publish-prod: build test ## Publish collections to production server
	@echo "Publishing collections to production server..."
	@if [ -z "$${ANSIBLE_GALAXY_TOKEN}" ]; then \
		echo "ERROR: ANSIBLE_GALAXY_TOKEN is not set"; \
		echo "       Try: export ANSIBLE_GALAXY_TOKEN=your-token-here"; \
		exit 1; \
	fi
	@if [ -n "$(COLLECTION)" ]; then \
		if [ ! -f "$(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz" ]; then \
			echo "Error: Built collection not found: $(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz"; \
			exit 1; \
		fi; \
		ansible-galaxy collection publish -vvv \
			--server $(GALAXY_PROD_SERVER) \
			--api-key "$${ANSIBLE_GALAXY_TOKEN}" \
			"$(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz"; \
	else \
		if [ ! -f "$(BIN_DIR)/publish20-prod.sh" ]; then \
			echo "Error: publish20-prod.sh script not found in $(BIN_DIR)"; \
			exit 1; \
		fi; \
		$(BIN_DIR)/publish20-prod.sh "$(COLLECTIONS)" "$${ANSIBLE_GALAXY_TOKEN}" "$(DIST_DIR)"; \
	fi

# ====================================================================
# Installation Targets
# ====================================================================

# Installation from different sources
inst-src: ## Install collections from source directories
	@echo "Installing collections from source..."
	@if [ ! -f "$(BIN_DIR)/install-from10-src.sh" ]; then \
		echo "Error: install-from10-src.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/install-from10-src.sh "$(COLLECTIONS)" "$(COLLECTIONS_DIR)"

inst-repo: ## Install collections from git repository
	@echo "Installing collections from git repository..."
	@if [ ! -f "$(BIN_DIR)/install-from20-repo.sh" ]; then \
		echo "Error: install-from20-repo.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/install-from20-repo.sh "$(COLLECTIONS)"

# (Duplicate targets removed - using the more complete versions above)

inst-prod: ## Install collections from production server
	@echo "Installing collections from production server..."
	@if [ -z "$(GALAXY_PROD_SERVER)" ]; then \
		echo "Error: GALAXY_PROD_SERVER is not set"; \
		exit 1; \
	fi
	@if [ ! -f "$(BIN_DIR)/install-from50-prod.sh" ]; then \
		echo "Error: install-from50-prod.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@$(BIN_DIR)/install-from50-prod.sh "$(COLLECTIONS)" "$(GALAXY_PROD_SERVER)"

# Uninstall collections using ansible-galaxy
uninstall: ## Uninstall all collections from ansible-galaxy
	@echo "Uninstalling collections..."
	@for collection in $(COLLECTIONS); do \
		echo "\n=== Uninstalling collection: levonk.$$collection ==="; \
		ansible-galaxy collection remove levonk.$$collection || echo "Collection levonk.$$collection not installed or already removed"; \
	done
	@echo "\nCollections have been uninstalled. Note: This only removes the collections from ansible-galaxy's installation directory."

# ====================================================================
# Deployment Targets
# ====================================================================

deploy: deploy-dev ## Deploy to development environment (default)

deploy-dev: build ## Deploy to development environment
	@echo "Deploying to development environment..."
	@for collection in $(COLLECTIONS); do \
		echo "\n=== Deploying collection: $$collection (dev) ==="; \
		(cd $(COLLECTIONS_DIR)/$$collection && $(MAKE) deploy-dev) || exit 1; \
	done

deploy-prod: check_prod_branch check_galaxy_token build ## Deploy to production environment
	@echo "Deploying to production environment..."
	@for collection in $(COLLECTIONS); do \
		echo "\n=== Deploying collection: $$collection (prod) ==="; \
		(cd $(COLLECTIONS_DIR)/$$collection && $(MAKE) deploy-prod) || exit 1; \
	done

# Publish to beta server (handles both single collection and multiple collections)
publish-beta: build test ## Publish collections to beta server
	@echo "Publishing collections to beta server..."
	@if [ -z "$${ANSIBLE_GALAXY_TOKEN}" ]; then \
		echo "ERROR: ANSIBLE_GALAXY_TOKEN is not set"; \
		echo "       Try: export ANSIBLE_GALAXY_TOKEN=your-token-here"; \
		exit 1; \
	fi
	@if [ ! -f "$(BIN_DIR)/publish10-beta.sh" ]; then \
		echo "Error: publish10-beta.sh script not found in $(BIN_DIR)"; \
		exit 1; \
	fi
	@if [ -n "$(COLLECTION)" ]; then \
		if [ ! -f "$(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz" ]; then \
			echo "Error: Built collection not found: $(DIST_DIR)/$(NAMESPACE)-$(COLLECTION)-*.tar.gz"; \
			exit 1; \
		fi; \
		$(BIN_DIR)/publish10-beta.sh "$(COLLECTION)" "$${ANSIBLE_GALAXY_TOKEN}" "$(DIST_DIR)"; \
	else \
		$(BIN_DIR)/publish10-beta.sh "$(COLLECTIONS)" "$${ANSIBLE_GALAXY_TOKEN}" "$(DIST_DIR)"; \
	fi

# Promote collections by incrementing the build (patch) version number
promote: ## Increment version numbers for collections that exist on the beta server
	@echo "Promoting collections with BUILD version increment..."
	@if [ ! -f "$(ROOT_DIR)/bin/promote-versions.sh" ]; then \
		echo "ERROR: promote-versions.sh script not found in $(ROOT_DIR)/bin"; \
		exit 1; \
	fi
	@"$(ROOT_DIR)/bin/promote-versions.sh" --type=build "$(COLLECTIONS_DIR)" "$(COLLECTIONS)"
	@echo "Rebuilding collections with the new versions..."
	@rm -f $(BUILD_MARKER)
	@$(MAKE) build

# Verify installation from beta server
test-beta: ## Verify installation from beta server
	@echo "Testing installation from beta server..."
	@for collection in $(COLLECTIONS); do \
		echo "\n=== Testing installation of $$collection from beta ==="; \
		ansible-galaxy collection install -vvv \
			--force-with-deps \
			--server $(GALAXY_BETA_SERVER) \
			levonk.$${collection//-/_}:$(VERSION) || exit 1; \
	done

# Create beta version tag
git-tag-beta: check-git-clean
	@echo "Creating beta tag v$(VERSION)-beta..."
	git tag -a "v$(VERSION)-beta" -m "Beta release v$(VERSION)"

# Complete beta release workflow
beta: publish-beta test-beta git-tag-beta ## Complete beta release workflow

# Backup current production state
backup-prod: ## Backup current production state
	@echo "Backing up current production state..."
	@# Add backup commands here
	@echo "Backup functionality not yet implemented"

# (Duplicate publish-prod target removed - using the more complete version above)

# ====================================================================
# Promotion Targets
# ====================================================================

# Promote collections by incrementing the build version (patch) number
# This is the default promotion target used in the build pipeline
promote: promote-build

# Promote collections by incrementing the major version number
promote-major: $(TEST_MARKER)
	@echo "Promoting collections with MAJOR version increment..."
	@if [ ! -f "$(ROOT_DIR)/bin/promote-versions.sh" ]; then \
		echo "ERROR: promote-versions.sh script not found in $(ROOT_DIR)/bin"; \
		exit 1; \
	fi
	@"$(ROOT_DIR)/bin/promote-versions.sh" --type=major "$(COLLECTIONS_DIR)" "$(COLLECTIONS)"
	@echo "Rebuilding collections with the new versions..."
	@rm -f $(BUILD_MARKER)
	@$(MAKE) build

# Promote collections by incrementing the minor version number
promote-minor: $(TEST_MARKER)
	@echo "Promoting collections with MINOR version increment..."
	@if [ ! -f "$(ROOT_DIR)/bin/promote-versions.sh" ]; then \
		echo "ERROR: promote-versions.sh script not found in $(ROOT_DIR)/bin"; \
		exit 1; \
	fi
	@"$(ROOT_DIR)/bin/promote-versions.sh" --type=minor "$(COLLECTIONS_DIR)" "$(COLLECTIONS)"
	@echo "Rebuilding collections with the new versions..."
	@rm -f $(BUILD_MARKER)
	@$(MAKE) build

# Promote collections by incrementing the build (patch) version number
promote-build: $(TEST_MARKER)
	@echo "Promoting collections with BUILD version increment..."
	@if [ ! -f "$(ROOT_DIR)/bin/promote-versions.sh" ]; then \
		echo "ERROR: promote-versions.sh script not found in $(ROOT_DIR)/bin"; \
		exit 1; \
	fi
	@"$(ROOT_DIR)/bin/promote-versions.sh" --type=build "$(COLLECTIONS_DIR)" "$(COLLECTIONS)"
	@echo "Rebuilding collections with the new versions..."
	@rm -f $(BUILD_MARKER)
	@$(MAKE) build

# Verify installation from production
test-prod: ## Verify installation from production server
	@echo "Testing installation from production server..."
	@for collection in $(COLLECTIONS); do \
		echo "\n=== Testing installation of $$collection from production ==="; \
		ansible-galaxy collection install -vvv \
			--force-with-deps \
			--server $(GALAXY_PROD_SERVER) \
			levonk.$${collection//-/_}:$(VERSION) || exit 1; \
	done

# Create production version tag
git-tag-prod: check-git-clean
	@echo "Creating production tag v$(VERSION)..."
	git tag -a "v$(VERSION)" -m "Production release v$(VERSION)"

# Rollback from production backup
rollback-prod: ## Restore from production backup
	@echo "Rolling back production from backup..."
	@# Add rollback commands here
	@echo "Rollback functionality not yet implemented"

# Complete production release workflow
prod: backup-prod publish-prod test-prod git-tag-prod ## Complete production release workflow

# Development beta target (skips token check)
dev-beta: build test
	@echo "Creating beta marker file for development purposes (skipping actual publishing)"
	@mkdir -p $(MARKER_DIR)
	@touch $(BETA_MARKER)

# Reset all markers to force full rebuild
reset: ## Reset all markers to force full rebuild
	@echo "Resetting build markers..."
	@rm -f $(MARKER_DIR)/*.marker
	@mkdir -p $(MARKER_DIR)
	@echo "Build markers have been reset. Next build will be a full rebuild."

# ====================================================================
# Release Management
# ====================================================================

release: ## Create a new release
	@echo "Creating a new release..."
	@# Add release process commands here
	@echo "Release process not yet implemented"

# ====================================================================
# Help Generation
# ====================================================================

# This target is used by the main help target to include additional help text
help-targets::
	@echo "\nCore Targets:"
	@echo "  all             - Build and test all collections (default)"
	@echo "  build           - Build all collections"
	@echo "  clean           - Remove build artifacts"

	@echo "\nTesting:"
	@echo "  test            - Run tests for all collections"
	@echo "  test-build      - Build and run tests in a container"
	@echo "  test-src        - Test installation from source"
	@echo "  test-repo       - Test installation from repository"
	@echo "  test-beta       - Verify installation from beta server"
	@echo "  test-prod       - Verify installation from production"
	@echo "  coverage-check  - Verify test coverage meets requirements"

	@echo "\nLinting:"
	@echo "  lint            - Run all linters (includes all lint-* targets)"
	@echo "  lint-ansible    - Lint Ansible content"
	@echo "  lint-markdown   - Lint Markdown files"
	@echo "  lint-yaml       - Lint YAML files"
	@echo "  lint-galaxy     - Lint galaxy.yml files"

	@echo "\nVersion Management:"
	@echo "  promote         - Update version numbers (alias for promote-build)"
	@echo "  promote-build   - Promote with build version increment"
	@echo "  promote-minor   - Promote with minor version increment"
	@echo "  promote-major   - Promote with major version increment"

	@echo "\nPublishing:"
	@echo "  publish-beta    - Upload to beta server"
	@echo "  publish-prod    - Promote to production server"
	@echo "  beta            - Complete beta release workflow (publish-beta + test-beta)"
	@echo "  prod            - Complete production release workflow (publish-prod + test-prod)"
	@echo "  backup-prod     - Backup current production state"
	@echo "  rollback-prod   - Restore from production backup"

	@echo "\nInstallation:"
	@echo "  inst-src        - Install from source directories"
	@echo "  inst-repo       - Install from git repository"
	@echo "  inst-build      - Install from built artifacts"
	@echo "  inst-beta       - Install from beta server"
	@echo "  inst-prod       - Install from production server"

	@echo "\nDevelopment:"
	@echo "  new-collection  - Create a new collection"
	@echo "  new-role        - Create a new role in a collection"
	@echo "  new-module      - Create a new module"
	@echo "  env             - Show development environment information"
	@echo "  sync            - Sync with remote repository (git pull --rebase)"
	@echo "  watch           - Watch for file changes and rebuild"
	@echo "  reset           - Reset build markers for full rebuild"
	@echo "  release         - Create a new release"

	@echo "\nExecution Environment:"
	@echo "  ee-build        - Build the execution environment image"
	@echo "  ee-test         - Run tests in the execution environment"
	@echo "  ee-lint         - Run linters in the execution environment"
	@echo "  ee-shell        - Get a shell in the execution environment"
	@echo "  ee-clean        - Clean execution environment images"
	@echo "  env-check       - Check environment for required tools"
	@echo "  ee-check        - Check Docker environment"

	@echo "\nDebugging:"
	@echo "  debug           - Show debug information about the environment"
	@echo "  dev-beta        - Create beta marker for development (skips actual publishing)"

endif # MAKEFILE_TARGETS_INCLUDED
