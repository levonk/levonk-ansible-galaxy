# Makefile.targets - Additional targets for the Ansible Galaxy collection
# This file contains installation targets that delegate to scripts in the bin/ directory.
# See README.md for detailed documentation on each target.

# Get the root directory of the project
ROOT_DIR := $(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))
BIN_DIR := $(ROOT_DIR)/../bin

# Install from source directories
inst-src:
	@echo "Installing collections from source directories..."
	@$(BIN_DIR)/install-from10-src.sh $(filter-out $@,$(MAKECMDGOALS))

# Install from git repository
inst-repo:
	@echo "Installing collections from git repository..."
	@$(BIN_DIR)/install-from20-repo.sh $(filter-out $@,$(MAKECMDGOALS))

# Install from built artifacts
inst-build:
	@echo "Installing collections from build artifacts..."
	@$(BIN_DIR)/install-from30-build.sh $(filter-out $@,$(MAKECMDGOALS))

# Install from beta server
inst-beta:
	@echo "Installing collections from beta server..."
	@$(BIN_DIR)/install-from40-beta.sh $(filter-out $@,$(MAKECMDGOALS))

# Install from production server
inst-prod:
	@echo "Installing collections from production server..."
	@$(BIN_DIR)/install-from50-prod.sh $(filter-out $@,$(MAKECMDGOALS))

# Debug target to show variables
debug:
	@echo "ROOT_DIR: $(ROOT_DIR)"
	@echo "BIN_DIR: $(BIN_DIR)"
	@echo "COLLECTIONS_DIR: $(ROOT_DIR)/collections/ansible_collections/levonk"
	@echo "DIST_DIR: $(ROOT_DIR)/../dist"
	@echo "COLLECTIONS: $(shell ls $(ROOT_DIR)/collections/ansible_collections/levonk 2>/dev/null || echo "No collections found")
